{
  "id": 7,
  "uid": "apollo-classic",
  "title": "Apollo Classic",
  "tags": ["demo", "prometheus"],
  "timezone": "browser",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "custom",
        "current": {"text": "api", "value": "api"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prom-main"},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_requests_total{job=\"$job\"}[5m])",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Rows",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 8},
      "panels": [
        {
          "id": 3,
          "title": "Healthy",
          "type": "stat",
          "gridPos": {"h": 4, "w": 12, "x": 0, "y": 9},
          "datasource": "Prometheus",
          "targets": [
            {"expr": "up{job=\"$job\"}", "instant": true}
          ]
        }
      ]
    }
  ]
}
