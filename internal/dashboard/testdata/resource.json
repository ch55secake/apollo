{
  "kind": "Dashboard",
  "apiVersion": "dashboard.grafana.app/v1",
  "metadata": {"name": "apollo-resource"},
  "spec": {
    "uid": "apollo-resource",
    "title": "Apollo Resource",
    "time": {"from": "now-1h", "to": "now"},
    "panels": [
      {
        "id": 1,
        "title": "CPU",
        "type": "graph",
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 0},
        "targets": [
          {"refId": "A", "expr": "process_cpu_seconds_total", "range": true}
        ]
      }
    ]
  }
}
